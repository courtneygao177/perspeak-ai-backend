# Server-side only. Never place production credentials in VITE_* variables.
# Set these in your local server environment or deployment secret manager.
# GROUP_PROJECT_* values take priority. If omitted, the server can reuse the
# main PerspeakAI UNIFIED_BASE_URL, UNIFIED_API_KEY, and TEXT_MODEL variables.
AGGREGATOR_API_BASE_URL=https://your-api-provider.example/v1
AGGREGATOR_API_KEY=replace-with-server-side-secret
AGGREGATOR_MODEL=replace-with-model-id
# Optional: set when the API provider must be reached through a local HTTP proxy.
OUTBOUND_PROXY_URL=http://127.0.0.1:7890

# Build-time public values only — no credentials.
# GROUP_PROJECT_BASE=/group-project/
# VITE_GROUP_PROJECT_API_BASE=/group-project/api
