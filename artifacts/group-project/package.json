    "react-dom": "latest",
    "typescript": "latest",
    "undici": "^8.10.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
